# --- BetterAuth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public URL of the app (http://localhost:3000 locally, your Vercel URL in production)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database ---
# Production (Vercel): any Postgres (Neon / Supabase / Vercel Postgres).
# Leave empty locally to use a SQLite file (local.db).
DATABASE_URL=

# --- Social login (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Price API (optional override) ---
NEXT_PUBLIC_MAIN_API_URL=https://openapi.programming-hero.com/api/bazardor
NEXT_PUBLIC_API_BASE_1=https://api.api-store.workers.dev/api/bazardor
NEXT_PUBLIC_API_BASE_2=https://api.abcz.workers.dev/api/bazardor
